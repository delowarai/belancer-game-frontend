{
  "name": "belancer-game-frontend",
  "version": "1.0.0",
  "description": "Belancer Game browser frontend",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "test": "tsc src/games/engine.ts src/games/practiceGames.ts src/games/birdAim.ts src/games/birdLevels.ts --target ES2022 --module ES2022 --skipLibCheck --outDir .test-build && node --test tests/engine.test.mjs tests/birdAim.test.mjs tests/birdLevels.test.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "matter-js": "^0.20.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.3",
    "@types/matter-js": "^0.20.2",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "4.1.3",
    "typescript": "5.7.3",
    "vite": "6.4.4"
  }
}
